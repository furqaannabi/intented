# Names only, never values. The values live in the shared password manager.

# NEAR AI Cloud (firewall-core)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Optional; defaults to https://cloud-api.near.ai
NEAR_AI_BASE_URL=

# NEAR (contract, firewall-core, api)
NEAR_NETWORK=
CONTRACT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# 1Click (api)
ONECLICK_JWT=
ONECLICK_REFUND_TO=
BASE_RECIPIENT_ADDRESS=

# API (api)
PORT=
DATABASE_PATH=
WEB_ORIGINS=
# The agent's bearer token for POST /api/propose; without it the endpoint refuses everyone
AGENT_API_TOKEN=
# Optional; defaults to the public RPC for NEAR_NETWORK
NEAR_RPC_URL=

# Web (web); the API host that /api/proposals and /api/redteam/latest are proxied to. Defaults to http://localhost:8787
API_URL=
