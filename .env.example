# Names only, never values. The values live in the shared password manager.

# NEAR AI Cloud (firewall-core)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Optional; defaults to https://cloud-api.near.ai
NEAR_AI_BASE_URL=

# NEAR (contract, firewall-core, api)
NEAR_NETWORK=
CONTRACT_ACCOUNT_ID=
FACTORY_ACCOUNT_ID=
OWNER_ACCOUNT_ID=

# 1Click (api)
ONECLICK_JWT=
ONECLICK_REFUND_TO=
# Also the vendor's address on the paywall's Base routes
BASE_RECIPIENT_ADDRESS=
# Optional; the paywall reads Base receipts here on mainnet. Defaults to https://base-rpc.publicnode.com
BASE_RPC_URL=
# Optional; defaults to https://1click.chaindefuser.com. On testnet, the stand-in's URL, e.g. http://localhost:8403
ONECLICK_BASE_URL=

# The 1Click stand-in (agent), testnet only. The deposit account must be registered on wrap.testnet
ONECLICK_STANDIN_DEPOSIT=
# Optional; defaults to 8403 and 500 (whole USDC per wNEAR, fake, so a 4 USDC price fits the 0.01 wNEAR cap)
ONECLICK_STANDIN_PORT=
ONECLICK_STANDIN_RATE=
# Written by `pnpm oneclick-key` in agent/, never by hand. The seed signs the stand-in's quotes;
# the API checks them with the public key, which the owner also registers with set_one_click_key
ONECLICK_STANDIN_KEY=
ONECLICK_STANDIN_PUBLIC_KEY=

# API (api)
PORT=
DATABASE_PATH=
WEB_ORIGINS=
# Optional; 1 when the API runs behind a host's proxy, so the mandate rate limit reads the client from X-Forwarded-For
TRUST_PROXY=
# Optional; defaults to the public RPC for NEAR_NETWORK
NEAR_RPC_URL=
# Optional; verdicts across all wallets in any 24 hours. Unset, no daily cap. Set it on mainnet (about 50)
VERDICT_DAILY_CAP=

# The demo agent (agent), never the API: intented-agent.testnet's function-call key on CONTRACT_ACCOUNT_ID
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# Web (web); the API host that /api/proposals and /api/redteam/latest are proxied to. Defaults to http://localhost:8787
API_URL=
# Web; the site's public URL (https://…), so link previews get an absolute og:image. Without it they point at localhost
SITE_URL=
# Web; the network this build serves, testnet unless set. The mainnet site is a second build of the same app with mainnet here
NEXT_PUBLIC_NEAR_NETWORK=
# Web; the demo wallet. Defaults to intented-wallet.testnet; a mainnet build stops unless it is set
NEXT_PUBLIC_WALLET_ID=
# Web; the NEAR RPC the browser reads the wallet from. Defaults to FastNEAR's for the network
NEXT_PUBLIC_NEAR_RPC_URL=
# Web; each site's public URL, for the header's Testnet | Mainnet switch. A network left unset is left out of the switch
NEXT_PUBLIC_TESTNET_URL=
NEXT_PUBLIC_MAINNET_URL=
# Web; the build folder, for a second build in the same checkout (e.g. .next-mainnet). Defaults to .next
NEXT_DIST_DIR=

# Mainnet demo agent only: the account that pays 1Click deposit addresses' USDC registration (near CLI keychain)
STORAGE_SPONSOR_ID=
