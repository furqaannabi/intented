# Names only, never values. The values live in the shared password manager.

# NEAR AI Cloud (firewall-core)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Optional; defaults to https://cloud-api.near.ai
NEAR_AI_BASE_URL=

# NEAR (contract, firewall-core, api)
NEAR_NETWORK=
CONTRACT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# 1Click (api)
ONECLICK_JWT=
ONECLICK_REFUND_TO=
# Also the vendor's address on the paywall's Base routes
BASE_RECIPIENT_ADDRESS=
# Optional; the paywall reads Base receipts here on mainnet. Defaults to https://base-rpc.publicnode.com
BASE_RPC_URL=
# Optional; defaults to https://1click.chaindefuser.com. On testnet, the stand-in's URL, e.g. http://localhost:8403
ONECLICK_BASE_URL=

# The 1Click stand-in (agent), testnet only. The deposit account must be registered on wrap.testnet
ONECLICK_STANDIN_DEPOSIT=
# Optional; defaults to 8403 and 500 (whole USDC per wNEAR, fake, so a 4 USDC price fits the 0.01 wNEAR cap)
ONECLICK_STANDIN_PORT=
ONECLICK_STANDIN_RATE=
# Written by `pnpm oneclick-key` in agent/, never by hand. The seed signs the stand-in's quotes;
# the API checks them with the public key, which the owner also registers with set_one_click_key
ONECLICK_STANDIN_KEY=
ONECLICK_STANDIN_PUBLIC_KEY=

# API (api)
PORT=
DATABASE_PATH=
WEB_ORIGINS=
# The agent's bearer token for POST /api/propose; without it the endpoint refuses everyone
AGENT_API_TOKEN=
# Optional; defaults to the public RPC for NEAR_NETWORK
NEAR_RPC_URL=

# Web (web); the API host that /api/proposals and /api/redteam/latest are proxied to. Defaults to http://localhost:8787
API_URL=
