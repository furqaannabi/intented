{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Intented",
  "description": "Your agent only does what you intented. A NEAR wallet that pays only on a TEE-signed ALLOW for the owner's plain-English rules.",
  "colors": {
    "primary": "#4f7a00",
    "light": "#c8ff3d",
    "dark": "#3d5f00"
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      { "label": "GitHub", "href": "https://github.com/furqaannabi/intented" }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/furqaannabi/intented"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/how-it-works", "concepts/rules", "concepts/verdicts", "concepts/limits"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/library",
              "guides/mcp",
              "guides/raw-calls",
              "guides/manage-wallet",
              "guides/base-payments",
              "guides/verify-a-payment"
            ]
          },
          {
            "group": "Security",
            "pages": ["concepts/trust-model", "red-team"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": ["reference/cli", "reference/contract", "reference/errors"]
          },
          {
            "group": "HTTP API",
            "pages": [
              "reference/api",
              "POST /api/mandate",
              "GET /api/mandates/{text_hash}",
              "POST /api/quote",
              "POST /api/verdict",
              "POST /api/executed",
              "GET /api/proposals",
              "GET /api/proposals/{id}",
              "GET /api/redteam/latest"
            ],
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  }
}
